# Copie este arquivo para .env.local e preencha os valores.
# Nunca coloque valores reais neste arquivo: ele vai para o repositório.

# Públicas (podem chegar ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor (nunca use o prefixo NEXT_PUBLIC_ nestas)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ALERTA_EMAIL_REMETENTE=
CRON_SECRET=

# Só na demonstração pública: "true" mostra, no login, os botões de entrar como
# proprietário e como caixa. Deixe vazio numa loja de verdade.
DEMO_MODE=
