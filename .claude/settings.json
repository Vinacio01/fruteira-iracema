{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run db:tipos*)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test*)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx supabase status*)",
      "Bash(npx supabase start*)",
      "Bash(npx supabase stop*)",
      "Bash(npx supabase migration new *)",
      "Bash(docker ps*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "PowerShell(npm test*)",
      "PowerShell(npm run test*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npm run typecheck*)",
      "PowerShell(npx supabase status*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(*git push*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase link*)",
      "Bash(*supabase*--remote*)",
      "Bash(*supabase*--linked*)",
      "Bash(*demo:redefinir-producao*)",
      "PowerShell(*git push*)",
      "PowerShell(*vercel*)",
      "PowerShell(*supabase db push*)",
      "PowerShell(*supabase link*)",
      "PowerShell(*supabase*--remote*)",
      "PowerShell(*supabase*--linked*)",
      "PowerShell(*demo:redefinir-producao*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-arquivos.mjs\"",
            "timeout": 15,
            "statusMessage": "Conferindo arquivos protegidos"
          }
        ]
      }
    ]
  }
}
